# Build output
logs/
build/
build-*/
dist/
.qoder/repowiki/

# Rust workspace (cargo build output + local dev-run scratch root)
/target/
.devrun/

# Runtime state, written by the panel itself. A committed data/ports.json is precisely
# "my allocations overwrote yours": the numbers belong to one machine, not to the repo.
data/
# Downloaded service binaries (manifest installer).
Extensions/
# Site roots the panel creates at runtime (paths::wwwDir()).
WWW/

# Debug artifacts that must never be committed.
*.obj
*.ilk
*.pdb
*.exe

# Editor / IDE
.idea/
.vscode/
*~
*.swp
*.swo
CMakeUserPresets.json

# Windows/macOS 杂物
Thumbs.db
desktop.ini
.DS_Store

# Node / Python（构建脚本可能引入）
node_modules/
__pycache__/
*.pyc

# macOS (for the later Mac port)
*.app/
*.dmg/
*.dSYM/

# Scratch space for local debugging artifacts (screenshots, pid files).
.tmp/
