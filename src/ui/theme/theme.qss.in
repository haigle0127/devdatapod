/* devdatapod QSS - structure is hand-written, every token placeholder value is generated.
   Source of truth: design/devconsole.pen "variables" via scripts/gen-theme.mjs.
   Never put a literal color in this file; add a token to the .pen instead.
   Sizes mirror the .pen geometry (padding / gap / font sizes in device-independent px). */

* {
    font-family: {{fontStacks.body}};
}

#Screen { background: {{colors.surface}}; }

/* ---------- card surface ----------
   The .pen gives cards a #2620400D shadow (ink at 5% alpha). QSS has no box-shadow, so
   the 1px line border is what separates a card from the beige background. */
#Card {
    background: {{colors.card}};
    border: 1px solid {{colors.line}};
    border-radius: 8px;
}

/* ---------- title bar (46px, no native frame) ---------- */
#TitleBar { background: {{colors.card}}; border-bottom: 1px solid {{colors.line}}; }
#AppTitle {
    font-family: {{fontStacks.heading}}; font-size: 15px; font-weight: 500; color: {{colors.ink}};
}
#AppDomain { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}}; }
#WindowBtn, #WindowBtnClose {
    border: none; background: transparent; padding: 0; margin: 0;
}
#WindowBtn:hover { background: {{colors.track}}; }
#WindowBtnClose:hover { background: {{colors.danger}}; }

/* ---------- sidebar (216px) ---------- */
#Sidebar { background: {{colors.sidebar}}; }
#Brand {
    font-family: {{fontStacks.heading}}; font-size: 24px; font-weight: 500; color: {{colors.card}};
}
#BrandSub { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.sidebar-text}}; }
#NavBtn {
    border: none; background: transparent; color: {{colors.sidebar-text}};
    font-family: {{fontStacks.body}}; font-size: 13px; text-align: left;
    padding: 10px 12px; border-radius: 8px;
}
#NavBtn:hover { background: rgba({{rgb.card}}, 0.08); color: {{colors.card}}; }
#NavBtn:checked {
    background: {{colors.accent}}; color: {{colors.card}}; font-weight: 500;
}
#PromoCard {
    border: none; border-radius: 8px;
    /* the .pen gradient stops are exactly $accent and $accent-3 */
    background: qlineargradient(x1: 0, y1: 0, x2: 0.34, y2: 1,
                                stop: 0 {{colors.accent}}, stop: 1 {{colors.accent-3}});
}
#PromoTitle {
    font-family: {{fontStacks.heading}}; font-size: 13px; font-weight: 500; color: {{colors.card}};
}
#PromoSub { font-family: {{fontStacks.cap}}; font-size: 11px; color: rgba({{rgb.card}}, 0.8); }

/* ---------- shared bits ---------- */
#AccentBar { background: {{colors.accent}}; border: none; border-radius: 2px; }
#AccentBar[tone="accent3"] { background: {{colors.accent-3}}; }
#SectionTitle {
    font-family: {{fontStacks.heading}}; font-size: 19px; font-weight: 500; color: {{colors.ink}};
}
#GroupTitle {
    font-family: {{fontStacks.heading}}; font-size: 14px; font-weight: 500; color: {{colors.ink}};
}
#SectionHint { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}}; }
#Divider { background: {{colors.line}}; border: none; }
#EmptyHint { font-size: 12px; color: {{colors.ink-2}}; }

/* ---------- 首页: announcement + hero ---------- */
#AnnText { font-size: 12px; color: {{colors.ink-2}}; }
#AnnLink { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.accent}}; }
#HeroDesc { font-size: 12px; color: {{colors.ink-2}}; }
#Chip {
    background: transparent; border: 1px solid {{colors.line}}; border-radius: 6px;
}
#ChipLabel { font-size: 13px; font-weight: 500; color: {{colors.ink}}; }
#ChipAction, #PrimaryBtn {
    background: {{colors.accent}}; color: {{colors.card}}; border: none; border-radius: 4px;
    font-family: {{fontStacks.body}}; font-size: 12px; font-weight: 500;
}
#ChipAction { padding: 7px 16px; }
#ChipAction:hover, #PrimaryBtn:hover { background: {{colors.accent-2}}; }
#PrimaryBtn { padding: 6px 15px; }
#PrimaryBtn:disabled { background: {{colors.track}}; color: {{colors.ink-2}}; }
#DangerBtn {
    background: {{colors.danger}}; color: {{colors.card}}; border: none; border-radius: 4px;
    font-family: {{fontStacks.body}}; font-size: 12px; font-weight: 500; padding: 6px 15px;
}
#DangerBtn:hover { background: {{colors.accent-3}}; }
#DangerBtn:disabled { background: {{colors.track}}; color: {{colors.ink-2}}; }

/* ---------- 首页: 套件 rows ---------- */
#ServiceRow { background: transparent; border: none; border-bottom: 1px solid {{colors.line}}; }
#SvcName { font-size: 13px; font-weight: 500; color: {{colors.ink}}; }
#SvcState { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}}; }
#SvcState[state="running"] { color: {{colors.success}}; }
#SvcState[state="starting"], #SvcState[state="switching"] { color: {{colors.warning}}; }
#SvcState[state="crashed"] { color: {{colors.danger}}; font-weight: 500; }
#RoleBadge { font-size: 11px; border-radius: 4px; padding: 2px 6px; }
#RoleBadge[role="default"] {
    background: {{colors.accent-soft}}; color: {{colors.accent}}; font-weight: 500;
}
#RoleBadge[role="secondary"] { background: {{colors.track}}; color: {{colors.ink-2}}; }
#PortTag {
    font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}};
    background: {{colors.track}}; border-radius: 4px; padding: 2px 6px;
}
#SoftBtn {
    background: {{colors.accent-soft}}; color: {{colors.accent}}; border: none; border-radius: 4px;
    font-family: {{fontStacks.body}}; font-size: 12px; font-weight: 500; padding: 6px 15px;
}
#SoftBtn:hover { background: rgba({{rgb.accent}}, 0.18); }
#SoftBtn:disabled { background: {{colors.track}}; color: {{colors.ink-2}}; }

/* ---------- 表单控件：弹窗输入框 + 站点页搜索框共用 ---------- */
#FieldInput {
    background: {{colors.card}}; border: 1px solid {{colors.line}}; border-radius: 6px;
    padding: 0 10px; font-family: {{fontStacks.body}}; font-size: 13px; color: {{colors.ink}};
}
#FieldInput:focus { border: 1px solid {{colors.accent}}; }

/* ---------- 网站页表格头 ---------- */
#TableHead { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}}; }

/* ---------- 资源信息键值行 ---------- */
#KvKey { font-size: 12px; color: {{colors.ink-2}}; }
#KvValue { font-size: 12px; color: {{colors.ink}}; }

/* ---------- 日志 tail 视图 ---------- */
#LogView {
    background: {{colors.surface}}; border: 1px solid {{colors.line}}; border-radius: 8px;
    padding: 8px; font-size: 11px; color: {{colors.ink}};
    /* 等宽字体：日志列对齐。没有 mono token，用系统常见等宽栈。 */
    font-family: "Cascadia Mono", "JetBrains Mono", Consolas, "Courier New", monospace;
}
#LogView QScrollBar:vertical {
    background: transparent; width: 8px; margin: 2px 0;
}
#LogView QScrollBar::handle:vertical {
    background: {{colors.track}}; border-radius: 4px; min-height: 24px;
}
#LogView QScrollBar::handle:vertical:hover { background: {{colors.line}}; }
#LogView QScrollBar::add-line:vertical, #LogView QScrollBar::sub-line:vertical {
    height: 0; background: none; border: none;
}
#LogView QScrollBar::add-page:vertical, #LogView QScrollBar::sub-page:vertical {
    background: none;
}

/* ---------- 套件列表滚动区：背景透明，滚动条细且贴 token ---------- */
#SuiteScroll { background: transparent; border: none; }
#SuiteBody { background: transparent; }
#SuiteScroll QScrollBar:vertical {
    background: transparent; width: 8px; margin: 2px 0;
}
#SuiteScroll QScrollBar::handle:vertical {
    background: {{colors.track}}; border-radius: 4px; min-height: 24px;
}
#SuiteScroll QScrollBar::handle:vertical:hover { background: {{colors.line}}; }
#SuiteScroll QScrollBar::add-line:vertical, #SuiteScroll QScrollBar::sub-line:vertical {
    height: 0; background: none; border: none;
}
#SuiteScroll QScrollBar::add-page:vertical, #SuiteScroll QScrollBar::sub-page:vertical {
    background: none;
}

/* ---------- status dots: 9px in rows, 8px in chips ---------- */
#StatusDot { border: none; border-radius: 99px; }
#StatusDot[state="running"] { background: {{colors.success}}; }
#StatusDot[state="stopped"], #StatusDot[state="crashed"] { background: {{colors.danger}}; }
#StatusDot[state="starting"], #StatusDot[state="switching"] { background: {{colors.warning}}; }
#StatusDot[state="idle"] { background: {{colors.line}}; }

/* ---------- 首页: bottom section ---------- */
#MenuBtn {
    border: none; background: transparent; color: {{colors.ink-2}};
    font-family: {{fontStacks.body}}; font-size: 12px; text-align: left;
    padding: 10px 12px; border-radius: 6px;
}
#MenuBtn:hover { background: rgba({{rgb.accent}}, 0.08); }
#MenuBtn:checked { background: {{colors.accent-soft}}; color: {{colors.accent}}; font-weight: 500; }

/* ---------- status bar (36px) ---------- */
#StatusBar {
    background: {{colors.card}}; border: 1px solid {{colors.line}}; border-radius: 8px;
}
#StatusChip { background: transparent; border: none; }
#StatusText { font-family: {{fontStacks.cap}}; font-size: 11px; color: {{colors.ink-2}}; }
